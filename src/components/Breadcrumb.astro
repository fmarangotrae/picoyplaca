---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    item: it.href ? new URL(it.href, Astro.site ?? 'https://picoyplaca.co').toString() : undefined
  }))
};
---
<nav aria-label="Migas de pan" class="mb-4">
  <ol class="flex flex-wrap items-center gap-2 text-xs text-slate-500 md:text-sm">
    {items.map((it, i, arr) => (
      <li class="flex items-center gap-2">
        {it.href && i < arr.length - 1 ? (
          <a href={it.href} class="hover:text-brand-700 hover:no-underline">{it.label}</a>
        ) : (
          <span class="text-slate-700 font-medium">{it.label}</span>
        )}
        {i < arr.length - 1 && <span class="text-slate-300" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</nav>
