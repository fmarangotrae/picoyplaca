---
import VehicleBadge from './VehicleBadge.astro';
import DigitsRow from './DigitsRow.astro';
import type { VehicleRestrictionEntry } from '../lib/pico';
import type { VehicleKind } from '../types';

export interface Props {
  kind: VehicleKind;
  entry: VehicleRestrictionEntry;
  cityName: string;
}

const { kind, entry, cityName } = Astro.props;

const statusClass = entry.canCirculateFullDay
  ? 'border-l-success-500 bg-success-50/30'
  : 'border-l-danger-500 bg-danger-50/30';

const horarios = entry.timeWindows.map(w => `${w.start} a ${w.end}`).join(' · ');
---
<article class={`card p-5 border-l-4 ${statusClass}`} aria-label={`Restricción ${kind} en ${cityName}`}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <VehicleBadge kind={kind} />
    {entry.canCirculateFullDay ? (
      <span class="badge bg-success-50 text-success-700 ring-1 ring-inset ring-success-500/20">
        ✅ Libre todo el día
      </span>
    ) : (
      <span class="badge bg-danger-50 text-danger-700 ring-1 ring-inset ring-danger-500/20">
        ⛔ Restringido
      </span>
    )}
  </div>

  <dl class="mt-4 grid gap-3 md:grid-cols-2">
    <div>
      <dt class="text-xs uppercase tracking-wider text-slate-500">Horario</dt>
      <dd class="mt-1 text-sm font-semibold text-slate-800">{horarios || '—'}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wider text-slate-500">Modo</dt>
      <dd class="mt-1 text-sm text-slate-800">
        {entry.mode === 'par-impar' && 'Par / Impar (día calendario)'}
        {entry.mode === 'digits-per-weekday' && 'Dígitos por día de semana'}
        {entry.mode === 'holidays-only' && 'Solo festivos especiales'}
        {entry.mode === 'none' && 'Sin restricción permanente'}
      </dd>
    </div>
  </dl>

  {entry.restrictedDigits && entry.restrictedDigits.length > 0 && (
    <div class="mt-4">
      <p class="mb-2 text-xs uppercase tracking-wider text-slate-500">
        Dígitos {entry.canCirculateFullDay ? 'exentos no aplica (último período registrado)' : 'NO pueden circular'}
      </p>
      <DigitsRow digits={entry.restrictedDigits} restricted={!entry.canCirculateFullDay} size="md" />
    </div>
  )}

  {entry.note && (
    <p class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800 ring-1 ring-inset ring-amber-500/20">
      ⚠️ {entry.note}
    </p>
  )}

  {entry.restrictedParImpar && (
    <p class="mt-3 text-sm text-slate-700">
      El día del mes tiene numeración <strong>{entry.restrictedParImpar === 'odd' ? 'IMPAR' : 'PAR'}</strong>.
      {entry.restrictedParImpar === 'odd'
        ? ' Circulan dígitos 1, 3, 5, 7 y 9.'
        : ' Circulan dígitos 0, 2, 4, 6 y 8.'}
    </p>
  )}
</article>
