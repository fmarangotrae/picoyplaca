---
import type { BannerSponsor } from '../types';

export interface Props {
  banner: BannerSponsor;
}

const { banner } = Astro.props;

const positionClasses: Record<BannerSponsor['position'], string> = {
  'top-hero': 'rounded-2xl border-2 border-brand-500/20 bg-gradient-to-r from-brand-50 to-white p-5',
  'side': 'card p-4',
  'inline': 'card p-4 my-6',
  'footer': 'card p-4'
};

const href = banner.href.includes('?')
  ? `${banner.href}&utm_campaign=${encodeURIComponent(banner.utmCampaign)}`
  : `${banner.href}?utm_campaign=${encodeURIComponent(banner.utmCampaign)}`;
---
{banner.enabled && (
  <div class={positionClasses[banner.position]}>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-brand-600">
        🎯 Patrocinado
      </span>
      <span class="text-xs text-slate-500">{banner.name}</span>
    </div>
    <p class="text-sm text-slate-800">{banner.text}</p>
    <a
      href={href}
      rel="sponsored noopener noreferrer"
      target="_blank"
      class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:no-underline"
    >
      {banner.cta}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
)}
