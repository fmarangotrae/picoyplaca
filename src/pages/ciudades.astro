---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import DigitsRow from '@components/DigitsRow.astro';
import AdSlot from '@components/AdSlot.astro';
import { CITIES } from '@data/cities';
import { formatDateISO, getDailyRestriction } from '@lib/pico';

const today = formatDateISO(new Date());
const citySummaries = CITIES.map(city => ({
  city,
  r: getDailyRestriction(city, today)
}));
---
<BaseLayout
  seo={{
    title: 'Ciudades con Pico y Placa en Colombia · Listado completo 2026',
    description: 'Consulta y compara el pico y placa de todas las ciudades principales de Colombia. Enlaces a página individual, calendario anual y variante taxis/motos para cada ciudad.',
    keywords: ['ciudades pico y placa colombia', 'todas ciudades pico y placa 2026']
  }}
>
  <Breadcrumb
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Ciudades' }
    ]}
  />

  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-700">
      Directorio ciudades
    </p>
    <h1 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">
      Pico y placa en Colombia · Todas las ciudades 2026
    </h1>
    <p class="mt-3 max-w-3xl text-slate-600">
      Selecciona una ciudad para ver la restricción del día, el calendario anual 2025-2027,
      variantes para taxis y motos, y las páginas mensuales SEO optimizadas.
    </p>
  </header>

  <AdSlot id="ciudades-top" size="leaderboard-728x90" text="Publicidad · listado ciudades" />

  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {citySummaries.map(({ city, r }) => (
      <article class="card overflow-hidden p-5">
        <div class="mb-3 flex items-start justify-between">
          <div>
            <p class="text-xs uppercase tracking-widest text-slate-500">{city.department}</p>
            <a href={`/${city.slug}`} class="mt-1 inline-block text-xl font-extrabold text-slate-900 hover:text-brand-700 hover:no-underline">
              {city.name}
            </a>
          </div>
          {r.isHoliday && <span class="badge bg-warning-50 text-warning-600">🎉 Festivo</span>}
          {!r.isHoliday && r.isWeekend && <span class="badge bg-brand-50 text-brand-700">☀️ FDS</span>}
        </div>
        <dl class="mt-3 grid grid-cols-3 gap-3 text-sm">
          <div>
            <dt class="text-xs text-slate-500">Carros</dt>
            <dd class="mt-1"><DigitsRow size="sm" digits={r.perVehicle.carro.restrictedDigits ?? []} restricted={!r.perVehicle.carro.canCirculateFullDay} /></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">Motos</dt>
            <dd class="mt-1"><DigitsRow size="sm" digits={r.perVehicle.moto.restrictedDigits ?? []} restricted={!r.perVehicle.moto.canCirculateFullDay} /></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">Taxis</dt>
            <dd class="mt-1"><DigitsRow size="sm" digits={r.perVehicle.taxi.restrictedDigits ?? []} restricted={!r.perVehicle.taxi.canCirculateFullDay} /></dd>
          </div>
        </dl>
        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <a href={`/${city.slug}`} class="btn-primary !px-3 !py-1.5 text-xs hover:no-underline">Ver hoy</a>
          <a href={`/calendario-pico-y-placa-${city.slug}-2025`} class="btn-secondary !px-3 !py-1.5 text-xs hover:no-underline">Cal. 2025</a>
          <a href={`/calendario-pico-y-placa-${city.slug}-2026`} class="btn-secondary !px-3 !py-1.5 text-xs hover:no-underline">Cal. 2026</a>
          <a href={`/calendario-pico-y-placa-${city.slug}-2027`} class="btn-secondary !px-3 !py-1.5 text-xs hover:no-underline">Cal. 2027</a>
          <a href={`/pico-y-placa/${city.slug}/taxis`} class="text-xs font-semibold text-brand-700 self-center">Taxis →</a>
          <a href={`/pico-y-placa/${city.slug}/motos`} class="text-xs font-semibold text-brand-700 self-center">Motos →</a>
        </div>
        <p class="mt-4 text-[11px] text-slate-500">Última actualización datos: {city.lastUpdated} · {city.rotations.length} rotaciones activas</p>
      </article>
    ))}
  </div>

  <AdSlot id="ciudades-bottom" size="auto-fluid" lazy text="Anuncio · debajo ciudades" />
</BaseLayout>
