---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import DigitsRow from '@components/DigitsRow.astro';
import CityDailyPanel from '@components/CityDailyPanel.astro';
import AdSlot from '@components/AdSlot.astro';
import { CITIES } from '@data/cities';
import { formatDateISO, getDailyRestriction } from '@lib/pico';
import { DAY_RECOMMENDATIONS } from '@data/fines';
import type { CityConfig } from '@types';

type Mode = 'variant' | 'month-year';
interface PageDataCommon {
  mode: Mode;
  city: CityConfig;
  breadcrumb: { label: string; href?: string }[];
  title: string;
  description: string;
  keywords?: string[];
}
interface VariantPage extends PageDataCommon {
  mode: 'variant';
  variant: 'taxis' | 'motos';
  variantCfg: { key: 'taxi' | 'moto'; titlePrefix: string; badge: string; recs: string[] };
  vehicleKey: 'taxi' | 'moto';
  todayR: ReturnType<typeof getDailyRestriction>;
  monthEntries: { iso: string; r: ReturnType<typeof getDailyRestriction> }[];
  todayISO: string;
  yearNow: number;
}
interface MonthYearPage extends PageDataCommon {
  mode: 'month-year';
  city: CityConfig;
  year: number;
  month: number;
  mm: string;
  monthName: string;
  days: { iso: string; r: ReturnType<typeof getDailyRestriction> }[];
}

export async function getStaticPaths() {
  const MONTH_NAMES_LONG = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
  ];
  const KIND_VARIANTS = {
    taxis: { key: 'taxi' as const, titlePrefix: 'para TAXIS', badge: '🚕', recs: [...DAY_RECOMMENDATIONS['taxi-allowed'], ...DAY_RECOMMENDATIONS['taxi-restricted']] },
    motos: { key: 'moto' as const, titlePrefix: 'para MOTOS', badge: '🏍️', recs: [...DAY_RECOMMENDATIONS.restricted] }
  };
  const paths: any[] = [];
  // Variante taxis/motos
  for (const city of CITIES) {
    for (const variant of ['taxis', 'motos'] as const) {
      const cfg = KIND_VARIANTS[variant];
      const today = formatDateISO(new Date());
      const todayR = getDailyRestriction(city, today);
      const dStart = new Date(); dStart.setDate(1);
      const dEnd = new Date(dStart.getFullYear(), dStart.getMonth() + 1, 0);
      const monthEntries: VariantPage['monthEntries'] = [];
      for (let d = new Date(dStart); d <= dEnd; d.setDate(d.getDate() + 1)) {
        const iso = formatDateISO(d);
        monthEntries.push({ iso, r: getDailyRestriction(city, iso) });
      }
      paths.push({
        params: { parts: `${city.slug}/${variant}` },
        props: {
          mode: 'variant',
          variant,
          variantCfg: cfg,
          vehicleKey: cfg.key,
          city,
          todayR,
          monthEntries,
          todayISO: today,
          yearNow: new Date().getFullYear(),
          breadcrumb: [
            { label: 'Inicio', href: '/' },
            { label: 'Ciudades', href: '/ciudades' },
            { label: city.name, href: `/${city.slug}` },
            { label: `${cfg.badge} ${variant.toUpperCase()}` }
          ],
          title: `Pico y placa ${cfg.titlePrefix} en ${city.name}`,
          description: variant === 'taxis'
            ? `Rotación taxis ${city.name}. Horarios, excepciones y dígitos restringidos del mes.`
            : `Restricción motos ${city.name}. Restricciones según último o primer dígito de la placa.`
        }
      });
    }
  }
  // Variante mes + año
  for (const city of CITIES) {
    for (const year of [2025, 2026, 2027]) {
      for (let m = 1; m <= 12; m++) {
        const mm = String(m).padStart(2, '0');
        const monthName = MONTH_NAMES_LONG[m - 1];
        const days: MonthYearPage['days'] = [];
        const dStart = new Date(year, m - 1, 1);
        const dEnd = new Date(year, m, 0);
        for (let d = new Date(dStart); d <= dEnd; d.setDate(d.getDate() + 1)) {
          const iso = formatDateISO(d);
          days.push({ iso, r: getDailyRestriction(city, iso) });
        }
        paths.push({
          params: { parts: `${city.slug}/${mm}/${year}` },
          props: {
            mode: 'month-year',
            city,
            year,
            month: m,
            mm,
            monthName,
            days,
            breadcrumb: [
              { label: 'Inicio', href: '/' },
              { label: 'Ciudades', href: '/ciudades' },
              { label: city.name, href: `/${city.slug}` },
              { label: `Calendario ${year}`, href: `/calendario-pico-y-placa-${city.slug}-${year}` },
              { label: `${monthName} ${year}` }
            ],
            title: `Pico y placa ${city.name} ${monthName} ${year}`,
            description: `Restricción pico y placa en ${city.name} durante ${monthName} ${year}. Horarios oficiales, dígitos por día y festivos.`,
            keywords: [`pico y placa ${city.slug} ${mm} ${year}`]
          }
        });
      }
    }
  }
  return paths;
}

const data = Astro.props as unknown as VariantPage | MonthYearPage;
---
<BaseLayout seo={{ title: data.title, description: data.description, keywords: (data as any).keywords }}>
  <Breadcrumb items={data.breadcrumb} />

  {data.mode === 'variant' && (() => {
    const p = data as VariantPage;
    const slotId = `kind-${p.city.slug}-${p.variant}`;
    return (
      <>
        <header class="mb-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-700">
            {p.variantCfg.badge} Restricción especial · {p.variant.toUpperCase()}
          </p>
          <h1 class="mt-2 text-3xl font-black md:text-4xl">{p.title}</h1>
          <p class="mt-3 max-w-3xl text-slate-600">{p.description}</p>
        </header>
        <AdSlot id={`${slotId}-top`} size="leaderboard-728x90" text={`${p.variant} ${p.city.name}`} />
        <div class="grid gap-6 lg:grid-cols-[2fr,1fr]">
          <article class="card p-5">
            <h2 class="text-lg font-extrabold">Hoy · {p.todayISO} · {p.city.name}</h2>
            <div class="mt-4">
              <p class="text-xs uppercase tracking-wider text-slate-500">
                Dígitos {p.todayR.perVehicle[p.vehicleKey].canCirculateFullDay ? 'LIBRE' : 'NO circulan'}
              </p>
              <div class="mt-3">
                <DigitsRow
                  size="lg"
                  restricted={!p.todayR.perVehicle[p.vehicleKey].canCirculateFullDay}
                  digits={p.todayR.perVehicle[p.vehicleKey].restrictedDigits ?? []}
                />
              </div>
              <p class="mt-4 text-sm text-slate-700">
                Horario: <strong>{p.todayR.perVehicle[p.vehicleKey].timeWindows.map(w => `${w.start} a ${w.end}`).join(' · ') || '—'}</strong>.
                ShiftOffset = {p.todayR.perVehicle[p.vehicleKey].shiftOffset ?? 0}.
              </p>
              {p.todayR.perVehicle[p.vehicleKey].note && (
                <p class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-500/20">
                  ℹ️ {p.todayR.perVehicle[p.vehicleKey].note}
                </p>
              )}
            </div>
            <h3 class="mt-8 text-lg font-extrabold">Mes actual · {new Date().toLocaleString('es-CO', { month: 'long' })} {p.yearNow}</h3>
            <div class="mt-4 overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="border-b border-slate-200 text-slate-600">
                    <th class="py-2 pr-3 text-left">Día</th>
                    <th class="py-2 px-3 text-left">Dígitos restringidos</th>
                    <th class="py-2 px-3 text-left">Observaciones</th>
                  </tr>
                </thead>
                <tbody>
                  {p.monthEntries.map(e => (
                    <tr class="border-b border-slate-100 align-top">
                      <td class="py-2 pr-3 font-semibold">{e.iso.slice(-2)}</td>
                      <td class="py-2 px-3">
                        {e.r.perVehicle[p.vehicleKey].canCirculateFullDay
                          ? <span class="badge bg-success-50 text-success-700">✅ Libre</span>
                          : <DigitsRow size="sm" restricted digits={e.r.perVehicle[p.vehicleKey].restrictedDigits ?? []} />}
                      </td>
                      <td class="py-2 px-3 text-xs text-slate-600">
                        {e.r.isHoliday && '🎉 Festivo '}
                        {e.r.isWeekend && '🌤️ FDS '}
                        {e.r.perVehicle[p.vehicleKey].note || ''}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
          <aside class="space-y-5">
            <div class="card p-5">
              <h2 class="text-lg font-extrabold">Recomendaciones</h2>
              <ul class="mt-3 list-inside list-disc space-y-2 text-sm text-slate-700">
                {p.variantCfg.recs.map(l => <li>{l}</li>)}
              </ul>
            </div>
            <div class="card p-5">
              <h2 class="text-lg font-extrabold">Fuentes oficiales</h2>
              <ul class="mt-3 space-y-2 text-sm break-all">
                {p.city.sourceUrls.map(s => <li><a href={s} target="_blank" rel="noopener noreferrer">{s}</a></li>)}
              </ul>
            </div>
            <AdSlot id={`${slotId}-side`} size="medium-rectangle-300x250" sticky />
          </aside>
        </div>
        <AdSlot id={`${slotId}-bottom`} size="auto-fluid" lazy />
      </>
    );
  })()}

  {data.mode === 'month-year' && (() => {
    const p = data as MonthYearPage;
    const slotId = `mes-${p.city.slug}-${p.mm}-${p.year}`;
    return (
      <>
        <header class="mb-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-700">Mes · {p.city.department}</p>
          <h1 class="mt-2 text-3xl font-black md:text-4xl">
            Pico y placa {p.city.name} · {p.monthName} {p.year}
          </h1>
          <p class="mt-3 max-w-3xl text-slate-600">{p.description}</p>
        </header>
        <AdSlot id={`${slotId}-top`} size="leaderboard-728x90" />
        <div class="space-y-6">
          {p.days.map(d => (
            <article id={`dia-${d.iso.slice(-2)}`} class="scroll-mt-24">
              <CityDailyPanel
                city={p.city}
                restriction={d.r}
                dateLabel={`${['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'][new Date(d.iso + 'T00:00:00').getDay()]} ${Number(d.iso.slice(-2))} de ${p.monthName}`}
              />
            </article>
          ))}
        </div>
        <AdSlot id={`${slotId}-bottom`} size="auto-fluid" lazy />
      </>
    );
  })()}
</BaseLayout>
