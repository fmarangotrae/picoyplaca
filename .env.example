# Cloudflare (requerido para MCP y wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Publicidad (pueden sobreescribirse desde KV admin)
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Turnstile (gratis unlimited en Cloudflare Free Tier)
# Obtener en Dashboard Cloudflare → Turnstile (opcional para forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend Free Tier 100 emails/día (OPCIONAL: solo si quieres notificaciones email de leads)
# Por defecto los leads se guardan en D1 y se leen desde /admin/leads
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@picoyplaca.co
RESEND_TO_EMAIL=admin@picoyplaca.co
